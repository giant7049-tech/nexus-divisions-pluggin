# ============================================================
# NEXUS OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
#
# FILE PURPOSE
# ------------
# This file defines the environment contract required by NEXUS OS.
#
# IMPORTANT:
#   - NEVER put real secrets in this file.
#   - Copy this file to ".env" for local development.
#   - Add production values directly to Render Environment Variables.
#   - ".env" must remain ignored by Git.
#
# Runtime:
#   Node.js >= 22
#
# Environments:
#   development
#   testing
#   staging
#   production
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

APP_NAME=NEXUS OS

APP_VERSION=1.0.0

APP_HOST=0.0.0.0

# Render automatically supplies PORT in production.
# Local development can use 3000.
PORT=3000

APP_URL=http://localhost:3000

API_PREFIX=/api

API_VERSION=v1


# ============================================================
# TRUST / PROXY
# ============================================================
#
# Render and other reverse proxies require correct proxy
# handling for secure cookies, request IPs and HTTPS detection.
#
# Recommended:
#   1 = trust the first proxy
#
# For local development:
#   0
# ============================================================

TRUST_PROXY=0


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info

LOG_PRETTY=true

LOG_REQUESTS=true

LOG_SECURITY_EVENTS=true

LOG_DATABASE_EVENTS=true


# ============================================================
# DATABASE
# ============================================================
#
# MongoDB is the initial persistence provider.
#
# Use a managed MongoDB connection string in production.
#
# NEVER commit the real connection string.
# ============================================================

DATABASE_PROVIDER=mongodb

DATABASE_URL=mongodb://127.0.0.1:27017/nexus_os

DATABASE_NAME=nexus_os

DATABASE_MAX_POOL_SIZE=20

DATABASE_MIN_POOL_SIZE=2

DATABASE_SERVER_SELECTION_TIMEOUT_MS=5000

DATABASE_CONNECT_TIMEOUT_MS=10000

DATABASE_SOCKET_TIMEOUT_MS=45000

DATABASE_RETRY_WRITES=true


# ============================================================
# AUTHENTICATION
# ============================================================
#
# These values MUST be replaced in real environments.
#
# JWT_SECRET must be long, random and unique per environment.
# ============================================================

AUTH_ENABLED=true

AUTH_SESSION_ENABLED=true

AUTH_TOKEN_ENABLED=true

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET

JWT_ALGORITHM=HS256

JWT_ISSUER=nexus-os

JWT_AUDIENCE=nexus-os-client

JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=30d

AUTH_MAX_LOGIN_ATTEMPTS=5

AUTH_LOCKOUT_MINUTES=15


# ============================================================
# COOKIES
# ============================================================

COOKIE_NAME=nexus_session

COOKIE_SECURE=false

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE=lax

COOKIE_DOMAIN=

COOKIE_PATH=/


# ============================================================
# CORS
# ============================================================
#
# Development:
#   http://localhost:3000
#
# Production:
#   Replace with the real NEXUS domain.
# ============================================================

CORS_ENABLED=true

CORS_ORIGIN=http://localhost:3000

CORS_CREDENTIALS=true

CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID


# ============================================================
# SECURITY
# ============================================================

SECURITY_HEADERS_ENABLED=true

RATE_LIMIT_ENABLED=true

RATE_LIMIT_MAX=100

RATE_LIMIT_WINDOW=1 minute

BODY_LIMIT_BYTES=1048576

REQUEST_TIMEOUT_MS=30000


# ============================================================
# SOCKET.IO / REALTIME
# ============================================================

REALTIME_ENABLED=true

REALTIME_PATH=/socket.io

REALTIME_TRANSPORTS=websocket,polling

REALTIME_PING_INTERVAL=25000

REALTIME_PING_TIMEOUT=20000

REALTIME_CONNECT_TIMEOUT=10000

REALTIME_MAX_HTTP_BUFFER_SIZE=1000000

REALTIME_CONNECTION_STATE_RECOVERY=true

REALTIME_RECOVERY_MAX_DISCONNECTION_DURATION=120000


# ============================================================
# SOCKET AUTHENTICATION
# ============================================================

SOCKET_AUTH_ENABLED=true

SOCKET_REQUIRE_AUTH=false

SOCKET_ALLOW_GUEST_CONNECTIONS=true

SOCKET_PRESENCE_ENABLED=true

SOCKET_TYPING_ENABLED=true

SOCKET_DELIVERY_RECEIPTS_ENABLED=true

SOCKET_READ_RECEIPTS_ENABLED=true

SOCKET_NOTIFICATIONS_ENABLED=true


# ============================================================
# EMAIL / SMTP
# ============================================================
#
# Leave disabled until a real SMTP provider is configured.
#
# Examples of providers can include:
#   - SMTP server supplied by your hosting/email provider
#   - transactional email provider
#
# Credentials must NEVER be committed.
# ============================================================

EMAIL_ENABLED=false

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM_NAME=NEXUS OS

SMTP_FROM_EMAIL=no-reply@example.com


# ============================================================
# CLOUDINARY / MEDIA STORAGE
# ============================================================
#
# Used for user/profile/listing/project media when enabled.
# ============================================================

CLOUDINARY_ENABLED=false

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

CLOUDINARY_FOLDER=nexus-os


# ============================================================
# PAYSTACK
# ============================================================
#
# Payments are architecturally supported but can remain disabled
# until the merchant account and production credentials are ready.
#
# NEVER expose PAYSTACK_SECRET_KEY in frontend JavaScript.
# ============================================================

PAYMENTS_ENABLED=false

PAYMENT_PROVIDER=paystack

PAYSTACK_PUBLIC_KEY=

PAYSTACK_SECRET_KEY=

PAYSTACK_WEBHOOK_SECRET=

PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

PAYMENT_CURRENCY=NGN

PAYMENT_TIMEOUT_MS=30000


# ============================================================
# PAYMENT SECURITY / IDEMPOTENCY
# ============================================================

PAYMENT_IDEMPOTENCY_ENABLED=true

PAYMENT_WEBHOOK_VERIFICATION_ENABLED=true

PAYMENT_TRANSACTION_LEDGER_ENABLED=true

PAYMENT_AUDIT_ENABLED=true


# ============================================================
# ANALYTICS
# ============================================================

ANALYTICS_ENABLED=true

ANALYTICS_EVENT_VALIDATION=true

ANALYTICS_DEDUPLICATION=true

ANALYTICS_AUDIT_ENABLED=true

ANALYTICS_ADMIN_ADJUSTMENTS_ENABLED=true


# ============================================================
# AUDIT / GOVERNANCE
# ============================================================

AUDIT_LOG_ENABLED=true

AUDIT_SECURITY_EVENTS=true

AUDIT_ADMIN_ACTIONS=true

AUDIT_FINANCIAL_ACTIONS=true

AUDIT_DATA_CHANGES=true

AUDIT_AUTH_EVENTS=true


# ============================================================
# INTELLIGENCE
# ============================================================
#
# AI integrations are provider-agnostic.
# Actual providers can be connected later through the
# NEXUS Intelligence gateway.
# ============================================================

INTELLIGENCE_ENABLED=false

AI_PROVIDER=

AI_API_KEY=

AI_MODEL=


# ============================================================
# AUTOMATION
# ============================================================

AUTOMATION_ENABLED=false

AUTOMATION_WORKERS_ENABLED=false

AUTOMATION_SCHEDULER_ENABLED=false


# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_CONNECT_ENABLED=true

FEATURE_PROFESSIONALS_ENABLED=true

FEATURE_SERVICES_ENABLED=true

FEATURE_JOBS_ENABLED=true

FEATURE_MARKETPLACE_ENABLED=true

FEATURE_PROJECTS_ENABLED=true

FEATURE_PROPERTY_ENABLED=true

FEATURE_CONSTRUCTION_ENABLED=true

FEATURE_ANALYTICS_ENABLED=true

FEATURE_INTELLIGENCE_ENABLED=false

FEATURE_AUTOMATION_ENABLED=false

FEATURE_PAYMENTS_ENABLED=false


# ============================================================
# HEALTH / READINESS
# ============================================================

HEALTH_ENABLED=true

HEALTH_DATABASE_CHECK=true

HEALTH_REALTIME_CHECK=true

HEALTH_CONFIGURATION_CHECK=true

READINESS_REQUIRES_DATABASE=true

READINESS_REQUIRES_REALTIME=true


# ============================================================
# SERVER SHUTDOWN
# ============================================================

SHUTDOWN_TIMEOUT_MS=10000

GRACEFUL_SHUTDOWN_ENABLED=true


# ============================================================
# REQUEST / TRACE IDENTIFICATION
# ============================================================

REQUEST_ID_ENABLED=true

REQUEST_ID_HEADER=X-Request-ID

TRACE_ID_ENABLED=true


# ============================================================
# FRONTEND
# ============================================================

STATIC_FILES_ENABLED=true

FRONTEND_DIRECTORY=public

FRONTEND_ENTRY=index.html

SPA_FALLBACK_ENABLED=true


# ============================================================
# DEVELOPMENT
# ============================================================

DEVTOOLS_ENABLED=true

DEV_API_LOGGING=true

DEV_SOCKET_LOGGING=true

DEV_DATABASE_LOGGING=false


# ============================================================
# PRODUCTION SAFETY
# ============================================================
#
# These should be changed when deploying to Render.
# ============================================================

PRODUCTION_REQUIRE_ENV_SECRETS=true

PRODUCTION_REQUIRE_DATABASE=true

PRODUCTION_REQUIRE_JWT_SECRET=true

PRODUCTION_DISABLE_PRETTY_LOGS=true

PRODUCTION_SECURE_COOKIES=true

PRODUCTION_DISABLE_GUEST_SOCKETS=true


# ============================================================
# NEXUS PLATFORM IDENTIFICATION
# ============================================================

PLATFORM_ID=nexus-os

PLATFORM_NAME=NEXUS OS

ORGANIZATION_NAME=Nexus Buildsolutions Limited

ARCHITECTURE_VERSION=1.0.0

MANIFEST_VERSION=1.0.0
