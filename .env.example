# ================================================================
# NEXUS CONNECT
# Environment Configuration Template
# ================================================================
#
# IMPORTANT:
# This file is a TEMPLATE ONLY.
#
# NEVER put real passwords, database credentials, JWT secrets,
# API keys, or private tokens in this file.
#
# For local development:
#     copy .env.example to .env
#
# For Render:
#     enter the real values in the Render Environment Variables
#     section.
# ================================================================


# ----------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------

NODE_ENV=production

APP_NAME=Nexus Connect

APP_VERSION=1.0.0

HOST=0.0.0.0

# Render supplies PORT automatically.
# Do NOT replace this with a fixed production port.
PORT=10000

API_PREFIX=/api


# ----------------------------------------------------------------
# PUBLIC APPLICATION URL
# ----------------------------------------------------------------
#
# Development example:
# http://localhost:10000
#
# Production example:
# https://nexusbuildsolutions.onrender.com
#
# Eventually this can become the public Connect URL if the domain
# is routed through the appropriate proxy/domain configuration.
# ----------------------------------------------------------------

APP_URL=https://nexusbuildsolutions.onrender.com


# ----------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------

PUBLIC_DIR=public

FRONTEND_URL=https://nexusbuildsolutions.onrender.com


# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
#
# Add the exact origins that are allowed to communicate with the
# Nexus Connect API.
#
# Do not use "*" in production when authentication/cookies are
# involved.
# ----------------------------------------------------------------

CORS_ORIGIN=https://nexusbuildsolutions.onrender.com


# ----------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------
#
# MongoDB Atlas connection string.
#
# NEVER commit the real connection string to GitHub.
#
# Example format:
#
# mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/nexus_connect
#
# The actual value belongs in Render Environment Variables.
# ----------------------------------------------------------------

MONGODB_URI=


# ----------------------------------------------------------------
# DATABASE NAME
# ----------------------------------------------------------------

MONGODB_DB_NAME=nexus_connect


# ----------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------
#
# JWT secret must be a long, random, private value.
#
# NEVER use:
#     password
#     nexus123
#     your company name
#     your username
#     a predictable sentence
#
# Generate a strong secret for the real environment.
# ----------------------------------------------------------------

JWT_SECRET=

JWT_EXPIRES_IN=7d


# ----------------------------------------------------------------
# AUTHENTICATION / PIN
# ----------------------------------------------------------------
#
# Nexus Connect uses a 4-digit PIN as the user's authentication
# credential.
#
# The actual PIN is NEVER stored in plaintext.
# It must be securely hashed by the backend.
# ----------------------------------------------------------------

PIN_LENGTH=4

PIN_MAX_ATTEMPTS=5

PIN_LOCKOUT_MINUTES=15


# ----------------------------------------------------------------
# SESSION SECURITY
# ----------------------------------------------------------------

SESSION_COOKIE_NAME=nexus_connect_session

SESSION_MAX_AGE_DAYS=30

COOKIE_SECURE=true

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE=lax


# ----------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------
#
# These values provide baseline protection.
# Sensitive authentication endpoints should have stricter limits.
# ----------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX=300

AUTH_RATE_LIMIT_MAX=10


# ----------------------------------------------------------------
# REQUEST LIMITS
# ----------------------------------------------------------------

JSON_BODY_LIMIT=2mb

URLENCODED_BODY_LIMIT=2mb


# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------

TRUST_PROXY=true


# ----------------------------------------------------------------
# REALTIME / SOCKET.IO
# ----------------------------------------------------------------
#
# Socket.IO uses the same application server.
# CORS must match the frontend origin.
# ----------------------------------------------------------------

SOCKET_CORS_ORIGIN=https://nexusbuildsolutions.onrender.com


# ----------------------------------------------------------------
# FILE / MEDIA STORAGE
# ----------------------------------------------------------------
#
# These are reserved for the media architecture.
#
# Cloudinary can later handle:
#
#   images
#   videos
#   documents
#   voice notes
#   profile pictures
#   status media
#
# NEVER place real Cloudinary credentials in GitHub.
# ----------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=


# ----------------------------------------------------------------
# EMAIL
# ----------------------------------------------------------------
#
# Reserved for future account/security communication.
#
# Examples:
#
#   PIN reset
#   security alerts
#   account notifications
#   business notifications
#
# No email verification flow is required for the current
# Nexus Connect registration UX.
# ----------------------------------------------------------------

MAIL_HOST=

MAIL_PORT=587

MAIL_SECURE=false

MAIL_USER=

MAIL_PASSWORD=

MAIL_FROM_NAME=Nexus Connect

MAIL_FROM_EMAIL=


# ----------------------------------------------------------------
# AI
# ----------------------------------------------------------------
#
# Reserved for the Nexus AI layer.
#
# Future functionality can include:
#
#   smart replies
#   rewriting
#   translation
#   conversation summaries
#   task extraction
#   business assistant
#   quotation assistance
#
# The actual provider can be configured later without changing
# the core application architecture.
# ----------------------------------------------------------------

AI_PROVIDER=

AI_API_KEY=

AI_MODEL=


# ----------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------

LOG_LEVEL=info


# ----------------------------------------------------------------
# SHUTDOWN
# ----------------------------------------------------------------
#
# Maximum amount of time the application should wait during
# graceful shutdown before forcing termination.
# ----------------------------------------------------------------

SHUTDOWN_TIMEOUT_MS=10000


# ----------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------
#
# These allow features to be introduced safely in phases without
# redesigning the application architecture.
# ----------------------------------------------------------------

FEATURE_REALTIME=true

FEATURE_VOICE_NOTES=false

FEATURE_MEDIA=false

FEATURE_GROUPS=false

FEATURE_COMMUNITIES=false

FEATURE_AI=false

FEATURE_BUSINESS_ACCOUNTS=false

FEATURE_PWA=false


# ================================================================
# END OF NEXUS CONNECT ENVIRONMENT TEMPLATE
# ================================================================
