{
  "name": "nexus-os",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS OS — Nexus Buildsolutions Limited unified digital operating platform.",
  "keywords": [
    "nexus",
    "nexus-os",
    "nexus-buildsolutions",
    "construction",
    "engineering",
    "real-estate",
    "marketplace",
    "professional-network",
    "services",
    "projects",
    "payments",
    "communications",
    "analytics",
    "intelligence",
    "automation"
  ],
  "license": "UNLICENSED",
  "author": {
    "name": "Nexus Buildsolutions Limited"
  },

  "type": "module",

  "engines": {
    "node": ">=22.0.0 <27.0.0",
    "npm": ">=10.0.0"
  },

  "packageManager": "npm@10.9.3",

  "scripts": {
    "start": "node server/server.js",

    "dev": "node --watch server/server.js",

    "test": "npm run test:unit",

    "test:unit": "node --test tests/unit/**/*.test.js",

    "test:integration": "node --test tests/integration/**/*.test.js",

    "test:contract": "node --test tests/contract/**/*.test.js",

    "test:feature": "node --test tests/feature/**/*.test.js",

    "test:security": "node --test tests/security/**/*.test.js",

    "lint": "eslint .",

    "lint:fix": "eslint . --fix",

    "format": "prettier --write .",

    "format:check": "prettier --check .",

    "validate": "npm run lint && npm run format:check && npm test",

    "db:migrate": "node scripts/database/migrate.js",

    "db:seed": "node scripts/database/seed.js",

    "health": "node scripts/maintenance/health-check.js"
  },

  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",

    "bcrypt": "^6.0.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.0.0",

    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",

    "jsonwebtoken": "^9.0.2",

    "mongoose": "^8.18.0",
    "mongodb": "^6.18.0",

    "nanoid": "^5.1.5",

    "nodemailer": "^7.0.6",

    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",

    "socket.io": "^4.8.1",

    "zod": "^4.0.0"
  },

  "devDependencies": {
    "@eslint/js": "^9.33.0",

    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",

    "globals": "^16.3.0",

    "prettier": "^3.6.2",

    "typescript": "^5.9.2"
  },

  "overrides": {
    "cookie": "^1.0.2"
  },

  "npm": {
    "audit-level": "high"
  }
}
